{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "riggler",
  "version": "0.1.0",
  "identifier": "ah.riggler.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Riggler",
        "width": 455,
        "height": 120,
        "minWidth": 455,
        "maxWidth": 455,
        "minHeight": 120,
        "maxHeight": 120,
        "transparent": true,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
