import {
    Vertical,
    IconButton,
    Switch,
    Slider,
    SegmentedButton,
    Horizontal,
} from "../material-1.0/material.slint";

@rust-attr(derive(serde::Serialize, serde::Deserialize))
enum Screen {
  Jiggling,
  Setting, 
  About,
}

@rust-attr(derive(serde::Serialize, serde::Deserialize))
struct Configuration {
  delay: float,
  delta: float,
}

export global RigglerState {
    in-out property <Screen> activeScreen: Screen.Jiggling;
    in-out property <bool> isJiggling: false;
    in-out property <Configuration> config: { delay: 1, delta: 2 };

    callback onIsJigglingChanged(isJiggling: bool);
    callback onConfigurationChanged(config: Configuration);
    callback onActiveScreenChanged(screen: Screen);
    callback minimizeToTray();
}

global Theme {
    in-out property <color> bgColor: #fdf8fc;
}

component RightSegmentedRadioButton inherits Vertical {
    alignment: center;

    Vertical {
        alignment: center;

        Horizontal {
            alignment: end;

            SegmentedButton {
                height: 40px;

                items: [
                    { icon: @image-url("./icons/menu.svg") },
                    {
                        icon: @image-url("./icons/gear-icon.svg"),
                    },
                    {
                        icon: @image-url("./icons/question-mark.svg"),
                    },
                ];
                index_changed(index) => {
                    if (index == 0) {
                        RigglerState.activeScreen = Screen.Jiggling;
                        RigglerState.onActiveScreenChanged(Screen.Jiggling);
                    } else if (index == 1) {
                        RigglerState.activeScreen = Screen.Setting;
                        RigglerState.onActiveScreenChanged(Screen.Setting);
                    } else if (index == 2) {
                        RigglerState.activeScreen = Screen.About;
                        RigglerState.onActiveScreenChanged(Screen.About);
                    }
                }
            }

            IconButton {
                icon: @image-url("./icons/chevron-down-icon.svg");
                clicked => {
                    RigglerState.minimizeToTray();
                }
            }
        }
    }
}

component JigglingScreen {
    Vertical {
        alignment: center;

        Horizontal {
            alignment: space-evenly;

            Vertical {
                alignment: center;
                Horizontal {
                    alignment: space-between;

                    jigglingToggleSw := Switch {
                        width: 60px;
                        height: 30px;

                        checked: RigglerState.isJiggling;

                        checked_state_changed(checked) => {
                            RigglerState.isJiggling = checked;
                            RigglerState.onIsJigglingChanged(checked);
                        }
                    }

                    Text {
                        vertical-alignment: center;
                        font-size: 20px;
                        text: jigglingToggleSw.checked ? "Stop Jiggling" : "Jiggling";
                    }
                }
            }
        }
    }
}

component SettingScreen {
    Vertical {
        alignment: center;

        Horizontal {
            alignment: start;

            Vertical {
                Text {
                    vertical-alignment: center;
                    font-size: 20px;
                    font-weight: 800;
                    text: "delay " + delaySlider.value;
                }

                delaySlider := Slider {
                    width: 125px;
                    height: 10px;
                    maximum: 10;
                    minimum: 1;
                    value: RigglerState.config.delay;

                    value_changed(value) => {
                        let config: Configuration = { delta: RigglerState.config.delta, delay: value };

                        RigglerState.config = config;
                        RigglerState.onConfigurationChanged(config);
                    }
                }
            }

            Vertical {
                Text {
                    vertical-alignment: center;
                    font-size: 20px;
                    font-weight: 800;
                    text: "delta " + deltaSlider.value;
                }

                deltaSlider := Slider {
                    width: 125px;
                    height: 10px;
                    maximum: 15;
                    minimum: 1;
                    value: RigglerState.config.delta;

                    value_changed(value) => {
                        let config: Configuration = { delta: value, delay: RigglerState.config.delay };

                        RigglerState.config = config;
                        RigglerState.onConfigurationChanged(config);
                    }
                }
            }
        }
    }
}

component AboutScreen {
    Vertical {
        alignment: center;
        padding: 0px;

        Horizontal {
            alignment: start;
            padding: 0px;
            spacing: 0px;

            Image {
                vertical-alignment: ImageVerticalAlignment.center;
                horizontal-alignment: center;

                source: @image-url("./icons/riggler-icon1.png");
                width: 55px;
                height: 50px;
            }

            Vertical {
                Text {
                    text: "Riggler";
                    font-weight: 800;
                    font-size: 18px;
                }

                Text {
                    text: "Dead Simple Mouse Jiggler in Rust.";
                    font-size: 13px;
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    width: 600px;
    height: 90px;
    background: Theme.bgColor;
    title: "Riggler";

    Vertical {
        alignment: center;

        Horizontal {
            alignment: space-between;
            padding: -10px;
            spacing: 0px;

            if RigglerState.activeScreen == Screen.Jiggling:  JigglingScreen { }

            if RigglerState.activeScreen == Screen.Setting:  SettingScreen { }

            if RigglerState.activeScreen == Screen.About: AboutScreen { }

            RightSegmentedRadioButton {
                padding: 0px;
                padding-right: -5px;
                spacing: 0px;
            }
        }
    }
}
